{
  "version": "1.0.0",
  "configurations": [
    
    {
      "name": "TS-Node",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/nodemon",
      "runtimeArgs": [
        "--inspect=5858 -e ts,tsx --exec node -r ${workspaceRoot}/node_modules/.bin/ts-node/register ./index.ts --transpile-only"
      ],
      "program": "index.ts",
      "cwd": "${workspaceRoot}",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    },
    {
      "name": "Assets",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "update_assets.js",
      "args": ["C:\\Program Files (x86)\\Steam\\steamapps\\common\\Rust\\"],
      "cwd": "${workspaceRoot}",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}